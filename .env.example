# Supabase Configuration (dev vs prod via NODE_ENV)
# Get values from https://supabase.com/dashboard
# Development: NODE_ENV=development uses *_DEV_* vars
# Production: NODE_ENV=production uses *_PROD_* vars

# Dev (local / npm run dev)
NEXT_PUBLIC_SUPABASE_DEV_URL=https://your-dev-project.supabase.co
NEXT_PUBLIC_SUPABASE_DEV_ANON_KEY=your_dev_anon_key
SUPABASE_DEV_SERVICE_ROLE_KEY=your_dev_service_role_key

# Prod (npm run build/start / Vercel)
NEXT_PUBLIC_SUPABASE_PROD_URL=https://your-prod-project.supabase.co
NEXT_PUBLIC_SUPABASE_PROD_ANON_KEY=your_prod_anon_key
SUPABASE_PROD_SERVICE_ROLE_KEY=your_prod_service_role_key

# Legacy (fallback if *_DEV_* / *_PROD_* not set)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Stripe (subscriptions, webhooks)
# Get keys from https://dashboard.stripe.com/apikeys
# Webhook secret from https://dashboard.stripe.com/webhooks (endpoint: /api/webhooks/stripe)
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_xxx
STRIPE_STUDIO_PRICE_ID=price_xxx

# Optional: for scripts/stressTestStories.ts (service role; no auth)
# SUPABASE_URL can be same as NEXT_PUBLIC_SUPABASE_URL
STRESS_TEST_USER_ID=uuid-of-user-to-attach-story-scenes-to
